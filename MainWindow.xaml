<Window x:Class="AccurateHireIQ.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" Background="#F5F7FB" Title="AccurateHire IQ — Screening Intelligence" Width="1480" Height="950" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,15"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Kpi" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#1E293B"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18"><ContentPresenter HorizontalAlignment="Left"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#142D4E"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="26,30,16,28"><TextBlock Text="ACCURATE" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="HIRE IQ" Foreground="#7FB2FF" FontSize="22" FontWeight="Light"/><TextBlock Text="SCREENING INTELLIGENCE" Foreground="#91A5BE" FontSize="9" Margin="0,13,0,0"/></StackPanel>
   <Border DockPanel.Dock="Bottom" Margin="18" Padding="14" Background="#203E60" CornerRadius="8"><StackPanel><TextBlock Text="HUMAN-LED DECISIONS" Foreground="#A7C4E8" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Intelligence for operations.&#x0a;Every source decision preserved." Foreground="#CBD5E1" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="WORKSPACE" Foreground="#8095AF" FontSize="10" Margin="26,0,0,10"/>
    <Button Style="{StaticResource Nav}" Content="◫   Dashboard" Command="{Binding Nav}" CommandParameter="Dashboard"/>
    <Button Style="{StaticResource Nav}" Content="↑   Upload Excel" Command="{Binding Nav}" CommandParameter="Upload Excel"/>
    <Button Style="{StaticResource Nav}" Content="☷   All Candidates" Command="{Binding Nav}" CommandParameter="All Candidates"/>
    <Button Style="{StaticResource Nav}" Content="●   PASS Candidates" Foreground="#86EFAC" Command="{Binding Nav}" CommandParameter="PASS Candidates"/>
    <Button Style="{StaticResource Nav}" Content="●   REVIEW Candidates" Foreground="#FCD34D" Command="{Binding Nav}" CommandParameter="REVIEW Candidates"/>
    <Button Style="{StaticResource Nav}" Content="●   Reject (STOP)" Foreground="#FCA5A5" Command="{Binding Nav}" CommandParameter="STOP Candidates"/>
    <Button Style="{StaticResource Nav}" Content="○   Unclassified Records" Command="{Binding Nav}" CommandParameter="Unclassified Records"/>
    <TextBlock Text="INTELLIGENCE" Foreground="#8095AF" FontSize="10" Margin="26,22,0,10"/>
    <Button Style="{StaticResource Nav}" Content="✧   AI Analysis Center" Command="{Binding Nav}" CommandParameter="AI Analysis Center"/>
    <Button Style="{StaticResource Nav}" Content="↗   AI Agent Chat" Command="{Binding Nav}" CommandParameter="AI Agent Chat"/>
    <Button Style="{StaticResource Nav}" Content="▤   Reports" Command="{Binding Nav}" CommandParameter="Reports"/>
    <Button Style="{StaticResource Nav}" Content="◷   Upload History" Command="{Binding Nav}" CommandParameter="Upload History"/>
    <Button Style="{StaticResource Nav}" Content="⚙   Settings" Command="{Binding Nav}" CommandParameter="Settings"/>
   </StackPanel></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="83"/><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,16"><DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#EFF6FF" CornerRadius="18" Padding="12,8" Margin="0,0,15,0"><TextBlock Text="{Binding AgentStatus}" Foreground="#2563EB" FontSize="11"/></Border><Button Content="↑  Upload Excel" Command="{Binding Upload}"/><Border Background="#E2E8F0" CornerRadius="18" Width="36" Height="36" Margin="10,0,0,0"><TextBlock Text="OP" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border></StackPanel>
    <StackPanel><TextBlock Text="ACCURATEHIRE IQ" FontWeight="Bold" FontSize="17"/><TextBlock Text="Agentic AI Screening Intelligence" Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/></StackPanel>
   </DockPanel></Border>
   <Grid Grid.Row="1" Margin="28,24,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="{Binding Today}" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/><TextBlock Text="{Binding Heading}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Amazon Seasonal Recruitment | Thanksgiving &amp; Christmas" Foreground="#64748B" Margin="0,7,0,0"/></StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding PageIndex}" Background="Transparent" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Background="#EAF1FF" CornerRadius="8" Padding="16,12" Margin="0,0,16,20"><DockPanel><Button Content="Load supplied sample" Command="{Binding Sample}" DockPanel.Dock="Right" Padding="12,7"/><StackPanel><TextBlock Text="ACTIVE DATASET" Foreground="#2563EB" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding ActiveFile}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
      <UniformGrid Columns="5" Margin="0,0,0,22">
       <Button Style="{StaticResource Kpi}" Command="{Binding Nav}" CommandParameter="All Candidates"><StackPanel><TextBlock Text="TOTAL CANDIDATES" FontSize="10" Foreground="#64748B"/><TextBlock Text="{Binding Total,StringFormat={}{0:N0}}" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Source records" FontSize="11" Foreground="#64748B"/></StackPanel></Button>
       <Button Style="{StaticResource Kpi}" Command="{Binding Nav}" CommandParameter="PASS Candidates"><StackPanel><TextBlock Text="●  PASS" Foreground="#16A34A" FontSize="11"/><TextBlock Text="{Binding Pass,StringFormat={}{0:N0}}" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding PassPercent}" FontSize="11" Foreground="#64748B"/></StackPanel></Button>
       <Button Style="{StaticResource Kpi}" Command="{Binding Nav}" CommandParameter="REVIEW Candidates"><StackPanel><TextBlock Text="●  REVIEW" Foreground="#D97706" FontSize="11"/><TextBlock Text="{Binding Review,StringFormat={}{0:N0}}" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding ReviewPercent}" FontSize="11" Foreground="#64748B"/></StackPanel></Button>
       <Button Style="{StaticResource Kpi}" Command="{Binding Nav}" CommandParameter="STOP Candidates"><StackPanel><TextBlock Text="●  REJECT (STOP)" Foreground="#DC2626" FontSize="11"/><TextBlock Text="{Binding Stop,StringFormat={}{0:N0}}" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding StopPercent}" FontSize="11" Foreground="#64748B"/></StackPanel></Button>
       <Button Style="{StaticResource Kpi}" Command="{Binding Nav}" CommandParameter="Unclassified Records"><StackPanel><TextBlock Text="○  UNCLASSIFIED" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Unclassified,StringFormat={}{0:N0}}" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding UnclassifiedPercent}" FontSize="11" Foreground="#64748B"/></StackPanel></Button>
      </UniformGrid>
      <TextBlock Text="{Binding DataNotice}" TextWrapping="Wrap" Foreground="#64748B" Margin="2,0,20,20"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Screening status" Style="{StaticResource Title}"/><lvc:PieChart Series="{Binding StatusSeries}" Height="235" LegendPosition="Bottom"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Status comparison" Style="{StaticResource Title}"/><lvc:CartesianChart Series="{Binding ComparisonSeries}" XAxes="{Binding StatusAxes}" Height="235"/></StackPanel></Border>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Job-role distribution" Style="{StaticResource Title}"/><lvc:CartesianChart Series="{Binding RoleSeries}" YAxes="{Binding RoleAxes}" Height="225"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Location breakdown · top 10" Style="{StaticResource Title}"/><lvc:CartesianChart Series="{Binding LocationSeries}" XAxes="{Binding LocationAxes}" Height="225" LegendPosition="Bottom"/></StackPanel></Border>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Verification follow-up" Style="{StaticResource Title}"/><TextBlock Text="Missing fields and explicit pending text; applicability requires review." Style="{StaticResource Muted}"/><lvc:CartesianChart Series="{Binding CompletenessSeries}" XAxes="{Binding CompletenessAxes}" Height="200"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Data quality summary" Style="{StaticResource Title}"/><ItemsControl ItemsSource="{Binding Quality}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,6"><TextBlock Text="{Binding Count,StringFormat={}{0:N0}}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Foreground="#64748B"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      </Grid>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Style="{StaticResource Card}" BorderBrush="#93B4F2" AllowDrop="True" DragOver="Upload_DragOver" Drop="Upload_Drop" Padding="25"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↑" FontSize="38" Foreground="#2563EB" HorizontalAlignment="Center"/><TextBlock Text="Drop your screening workbook here" FontSize="21" FontWeight="SemiBold" Margin="0,10"/><TextBlock Text="XLSX, XLS or CSV · original columns retained · import cancellation supported" Style="{StaticResource Muted}" HorizontalAlignment="Center"/><Button Content="Browse files" Command="{Binding Upload}" HorizontalAlignment="Center" Margin="0,20,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Column mapping" Style="{StaticResource Title}"/><TextBlock Text="{Binding FilePath}" TextWrapping="Wrap"/><TextBlock Text="{Binding MappingNotice}" Style="{StaticResource Muted}" Margin="0,10"/><WrapPanel>
       <StackPanel Width="235"><TextBlock Text="Worksheet"/><ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" SelectionChanged="Sheet_Changed"/></StackPanel>
       <StackPanel Width="235"><TextBlock Text="Candidate ID (optional mapping)"/><ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding IdColumn}"/></StackPanel>
       <StackPanel Width="235"><TextBlock Text="Candidate name *"/><ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding NameColumn}"/></StackPanel>
       <StackPanel Width="235"><TextBlock Text="Existing overall screening result"/><ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding StatusColumn}"/></StackPanel>
       <StackPanel Width="235"><TextBlock Text="Job role"/><ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding RoleColumn}"/></StackPanel>
       <StackPanel Width="235"><TextBlock Text="Location"/><ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding LocationColumn}"/></StackPanel>
       <StackPanel Width="235"><TextBlock Text="Screening remarks"/><ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding RemarksColumn}"/></StackPanel>
      </WrapPanel><DataGrid ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="True" Height="220" Margin="0,15,0,20"/><StackPanel Orientation="Horizontal"><Button Content="Validate &amp; import" Command="{Binding Import}"/><Button Content="Cancel operation" Command="{Binding Cancel}" Background="#64748B"/></StackPanel></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem><Grid Margin="0,0,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,15" Padding="16"><StackPanel><WrapPanel>
       <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="Search ID, name or remarks"/>
       <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding StatusFilter}" Width="155" ToolTip="Overall status"/>
       <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding RoleFilter}" Width="155" ToolTip="Job role"/>
       <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding LocationFilter}" Width="140" ToolTip="Location"/>
       <ComboBox ItemsSource="{Binding FindingTypes}" SelectedItem="{Binding FindingFilter}" Width="170" ToolTip="Finding type"/><ComboBox ItemsSource="{Binding SourceColumns}" SelectedItem="{Binding SourceColumnFilter}" Width="260" ToolTip="Exact source column"/><TextBox Text="{Binding SourceTextFilter}" Width="190" ToolTip="Source value contains"/>
      </WrapPanel><WrapPanel VerticalAlignment="Center"><TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding SortFields}" SelectedItem="{Binding Sort}"/><CheckBox Content="Descending" IsChecked="{Binding Desc}" VerticalAlignment="Center" Margin="0,0,15,0"/><Button Content="Apply filters" Command="{Binding Apply}"/><Button Content="Export all matches" Command="{Binding Export}" Background="#142D4E"/><Button Content="View details" Click="Details_Click" Background="#64748B"/></WrapPanel><TextBlock Text="Search name, candidate ID or remarks. Blank filters mean all. Double-click a record for source details." Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="11"/></StackPanel></Border>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" MouseDoubleClick="Details_Click" CanUserSortColumns="False"><DataGrid.Columns>
       <DataGridTextColumn Header="ROW" Binding="{Binding SourceRow}" Width="65"/><DataGridTextColumn Header="CANDIDATE ID" Binding="{Binding CandidateId}" Width="135"/><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="130"/><DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="95"/><DataGridTextColumn Header="CLASSIFICATION" Binding="{Binding StatusLabel}" Width="145"/><DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="160"/><DataGridTextColumn Header="CLASSIFICATION REASON" Binding="{Binding ClassificationReason}" Width="450"/>
      </DataGrid.Columns></DataGrid>
      <DockPanel Grid.Row="2" Margin="0,16,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" MinWidth="65" Width="65" ToolTip="Rows per page"/><Button Content="‹ Previous" Command="{Binding Previous}" Background="#64748B"/><Button Content="Next ›" Command="{Binding Next}"/></StackPanel><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center"/></DockPanel>
     </Grid></TabItem>
     <TabItem><Grid Margin="0,0,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Operational summary · calculated from source" Style="{StaticResource Title}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="23"/><StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Button Content="Ask agent to analyze" Click="Analyze_Click"/><Button Content="Export analysis workbook" Click="AnalysisExport_Click" Background="#142D4E"/></StackPanel><TextBlock Text="Evidence below uses deterministic checks. AI-generated explanations appear in chat. Showing up to 500 findings; analysis export includes all." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Findings}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="ROW" Binding="{Binding SourceRow}" Width="55"/><DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="145"/><DataGridTextColumn Header="SOURCE COLUMN" Binding="{Binding Column}" Width="210"/><DataGridTextColumn Header="SOURCE VALUE" Binding="{Binding Value}" Width="210"/><DataGridTextColumn Header="EXPLANATION" Binding="{Binding Explanation}" Width="300"/><DataGridTextColumn Header="FOLLOW-UP" Binding="{Binding FollowUp}" Width="300"/></DataGrid.Columns></DataGrid>
      <Border Grid.Row="2" Background="White" Padding="15" Margin="0,16,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Actual execution history" FontWeight="SemiBold" Margin="0,0,0,10"/><DataGrid ItemsSource="{Binding Logs}" RowHeight="30"><DataGrid.Columns><DataGridTextColumn Header="TOOL" Binding="{Binding Tool}" Width="210"/><DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
     </Grid></TabItem>
     <TabItem><Grid Margin="0,0,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Ask AccurateHire IQ" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Natural-language analysis with source references and recorded tool calls." Style="{StaticResource Muted}" Margin="0,7,0,12"/><WrapPanel><Button Content="Analyze this upload" Click="Suggestion_Click" Background="#142D4E"/><Button Content="Find pending verification tasks" Click="Suggestion_Click" Background="#142D4E"/><Button Content="Review prepared report" Command="{Binding Prepared}" Background="#64748B"/></WrapPanel></StackPanel></Border>
      <TextBox Grid.Row="1" Text="{Binding Conversation,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" BorderThickness="0" Padding="24" Margin="0" FontSize="14"/>
      <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBox Text="{Binding Prompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="75" TextWrapping="Wrap" ToolTip="Ask about the active batch"/><DockPanel><TextBlock Text="AI output requires review. No employment decisions or status changes." Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Command="{Binding Cancel}" Background="#64748B"/><Button Content="Send question →" Command="{Binding Send}"/></StackPanel></DockPanel></StackPanel>
     </Grid></TabItem>
     <TabItem><ScrollViewer><StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Export center" Style="{StaticResource Title}"/><TextBlock Text="Exports include all matching rows and every original column. Choose XLSX or CSV and a save location. Formula-like text is escaped for spreadsheet safety." Style="{StaticResource Muted}"/><WrapPanel Margin="0,20,0,0"><Button Content="All candidates" Tag="" Click="CategoryExport_Click"/><Button Content="PASS" Tag="PASS" Click="CategoryExport_Click" Background="#16A34A"/><Button Content="REVIEW" Tag="REVIEW" Click="CategoryExport_Click" Background="#D97706"/><Button Content="Reject (STOP)" Tag="STOP" Click="CategoryExport_Click" Background="#DC2626"/><Button Content="Unclassified" Tag="UNCLASSIFIED" Click="CategoryExport_Click" Background="#64748B"/></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Operational analysis workbook" Click="AnalysisExport_Click" Background="#142D4E"/><Button Content="Generate 10,000-row demo" Click="Demo_Click" Background="#64748B"/><Button Content="Build a filtered report" Command="{Binding Nav}" CommandParameter="All Candidates"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Agent-assisted reports" Style="{StaticResource Title}"/><TextBlock Text="Ask the agent to prepare a report, inspect its filters in the candidate list, then select Export all matches. The agent cannot write files or change screening statuses." Style="{StaticResource Muted}"/><Button Content="Open AI Agent Chat" Command="{Binding Nav}" CommandParameter="AI Agent Chat" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem><Grid Margin="0,0,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="Open selected batch" Command="{Binding SelectBatch}"/><Button Content="Delete active batch…" Command="{Binding DeleteBatch}" Background="#DC2626"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedBatch}"><DataGrid.Columns><DataGridTextColumn Header="BATCH" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="SOURCE FILE" Binding="{Binding File}" Width="*"/><DataGridTextColumn Header="RECORDS" Binding="{Binding Count}" Width="100"/><DataGridTextColumn Header="IMPORTED" Binding="{Binding Imported}" Width="260"/></DataGrid.Columns></DataGrid></Grid></TabItem>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI provider" Style="{StaticResource Title}"/><TextBlock Text="Use an OpenAI-compatible chat endpoint, Azure OpenAI v1, or local Ollama with a tool-capable model. No model or API key is bundled." Style="{StaticResource Muted}"/><TextBlock Text="Endpoint" Margin="0,20,0,0"/><TextBox Text="{Binding Endpoint}"/><TextBlock Text="Model / Azure deployment name"/><TextBox Text="{Binding Model}"/><TextBlock Text="API key (leave blank to retain the saved key; Ollama usually needs none)"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="Key_Changed" Padding="10" Margin="0,8,8,16"/><TextBlock Text="Request timeout in seconds (15–180)"/><TextBox Text="{Binding TimeoutSeconds}" Width="120" HorizontalAlignment="Left"/>
       <CheckBox Content="Allow external AI transmission" IsChecked="{Binding AllowExternal}" Margin="0,12"/><TextBlock Text="Enabling this sends your chat messages, aggregate statistics, candidate IDs and bounded screening-field excerpts to the configured provider. Names, gender, addresses and contact columns are excluded from tools; email/phone patterns in excerpts are masked. Free text can still contain sensitive information. Use only an approved provider." Style="{StaticResource Muted}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local privacy &amp; data controls" Style="{StaticResource Title}"/><CheckBox Content="Mask candidate names in list views" IsChecked="{Binding MaskPersonal}" Margin="0,8"/><CheckBox Content="Enable report exports for this local user" IsChecked="{Binding AllowExports}" Margin="0,8"/><TextBlock Text="API credentials use Windows user encryption. The SQLite database is stored under your Windows LocalAppData profile; database contents are not encrypted. Use device encryption and an authorized Windows account for sensitive data. This single-user build does not implement enterprise role-based access. Delete batches in Upload History; exported files must be managed separately." Style="{StaticResource Muted}" Margin="0,12"/><Button Content="Save settings" Command="{Binding SaveSettings}" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
   <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="28,8"><DockPanel><ProgressBar DockPanel.Dock="Right" Width="90" Height="6" IsIndeterminate="{Binding Busy}"/><TextBlock Text="{Binding Activity}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
